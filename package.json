{
  "name": "invite-me",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "@types/node": "^26.6.6",
      "varlock": "1.25.0",
      "@cloudflare/workers-types": "^5.20261112.1",
      "@orpc/server": "^1.16.2",
      "@orpc/openapi": "^1.16.2",
      "@orpc/zod": "^1.16.2",
      "better-auth": "1.7.22",
      "lucide-react": "^1.72.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.5",
      "@orpc/client": "^1.16.2",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev",
    "build": "nx run-many -t build",
    "check-types": "nx run-many -t check-types",
    "dev:web": "nx run-many -t dev:bare --projects=web",
    "dev:server": "nx run-many -t dev:bare --projects=hono",
    "db:push": "nx run-many -t db:push --projects=@invite-me/db",
    "db:studio": "nx run-many -t db:studio --projects=@invite-me/db",
    "db:generate": "nx run-many -t db:generate --projects=@invite-me/db",
    "db:migrate": "nx run-many -t db:migrate --projects=@invite-me/db",
    "deploy": "nx run-many -t deploy --projects=@invite-me/infra",
    "destroy": "nx run-many -t destroy --projects=@invite-me/infra",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@invite-me/config": "workspace:*",
    "@types/node": "catalog:",
    "nx": "^24.0.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
