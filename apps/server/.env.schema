# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# HMAC key that derives guest-link secrets. Rotating it invalidates every issued link.
# @type=string(minLength=32)
INVITE_LINK_KEY=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Optional. Google login is enabled only when both values are set.
# @type=string
GOOGLE_CLIENT_ID=

# @type=string
GOOGLE_CLIENT_SECRET=

# Optional. GitHub login is enabled only when both values are set.
# @type=string
GITHUB_CLIENT_ID=

# @type=string
GITHUB_CLIENT_SECRET=

# Email sender: "console" logs messages (default), "resend" sends via Resend.
# @type=string
EMAIL_PROVIDER=console

# Required only when EMAIL_PROVIDER=resend.
# @type=string
RESEND_API_KEY=

# @type=string
EMAIL_FROM=
